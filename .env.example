# Copiar a .env (está en .gitignore) y cambiar los valores antes de levantar el stack.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Mismo valor en los 5 servicios. HS256 necesita al menos 32 bytes (256 bits).
# Generar uno con: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-change-me

# Token entre payment-service y order-service (POST /orders/{id}/pay)
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# SUPER_ADMIN que crea auth-service en el primer arranque
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin1234

# Orígenes del frontend, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001
